# ==============================================================================
# Creator Engine - Environment Variables Template
# Copy this file to .env.local to configure your local environment
# ==============================================================================

# Supabase Configuration
# Obtain from your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Google Gemini API Configuration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-placeholder

# TinyFish Live-Web Search & Fetch API Configuration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
# Obtain from TinyFish Dashboard: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your-tinyfish-api-key-placeholder
